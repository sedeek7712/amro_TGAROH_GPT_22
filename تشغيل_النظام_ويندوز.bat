@echo off
chcp 65001 >nul
title نظام الإدارة التجارية والمحاسبية المتكامل - تشغيل محلي

echo ======================================================================
echo       نظام الإدارة التجارية والمحاسبية المتكامل (ERP)
echo             التشغيل المحلي التلقائي على بيئة Windows
echo ======================================================================
echo.

:: 1. التحقق من وجود Node.js
where node >nul 2>&1
if %ERRORLEVEL% neq 0 (
    echo [X] لم يتم العثور على Node.js على جهازك!
    echo     يرجى تحميل وتثبيت Node.js (الإصدار الموصى به LTS) من:
    echo     https://nodejs.org/
    echo.
    echo أو يمكنك فتح النسخة السحابية المباشرة في المتصفح:
    echo https://ais-pre-whq6c7263bbvzvlv2i2kaa-364280012769.europe-west3.run.app
    echo.
    pause
    exit /b
)

echo [✓] تم التحقق من Node.js بنجاح.

:: 2. التحقق من وجود مجلد node_modules (إذا لم يكن مثبتاً يتم تثبيته تلقائياً)
if not exist "node_modules\" (
    echo.
    echo [*] جاري تثبيت الحزم والمكتبات لأول مرة (npm install)...
    echo     يرجى الانتظار لحظات، هذه الخطوة تتم لمرة واحدة فقط.
    echo.
    call npm install
    if %ERRORLEVEL% neq 0 (
        echo.
        echo [!] حدث خطأ أثناء تثبيت المكتبات. يرجى التأكد من اتصال الإنترنت ثم إعادة المحاولة.
        pause
        exit /b
    )
    echo [✓] تم تثبيت جميع المكتبات بنجاح.
)

:: 3. فتح المتصفح تلقائياً وتشغيل خادم التطوير
echo.
echo [✓] جاري إطلاق النظام المحلي...
echo [*] سيتم فتح المتصفح تلقائياً على العنوان: http://localhost:3000
echo [*] لإيقاف النظام لاحقاً، اضغط Ctrl + C في هذه النافذة.
echo ======================================================================
echo.

start "" http://localhost:3000
call npm run dev

pause
