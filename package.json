{
  "name": "multi_activity_erp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=127.0.0.1",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/tests/*.test.ts",
    "test:legacy": "tsx src/tests/phase5_remediation_test.ts && tsx src/tests/phase6_e2e_workflow_test.ts",
    "verify:architecture": "node scripts/verify_data_service_boundary.mjs",
    "verify": "npm run lint && npm run verify:architecture && npm test && npm run test:legacy && npm run build",
    "build:windows:preview": "npm run build && npx --yes electron-builder@26.18.1 --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "dexie": "^4.4.7",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "fake-indexeddb": "^6.2.7",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0"
  },
  "productName": "نظام عمرو النماري للإدارة التجارية",
  "main": "electron/main.mjs",
  "build": {
    "appId": "com.amroalnmary.erp",
    "productName": "نظام عمرو النماري",
    "electronVersion": "45.4.1",
    "directories": {
      "output": "release/windows-preview"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "amro-erp-shell-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false
    }
  }
}
